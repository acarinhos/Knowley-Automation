# Copy to .env (git-ignored). Never commit real keys.
# Firebase service-account JSON: download from Firebase console and save it
# locally (e.g. ./serviceAccountKey.json - *.json is git-ignored), then point here.
FIREBASE_CREDENTIALS_PATH=./serviceAccountKey.json
FIREBASE_STORAGE_BUCKET=knowley-1-categories

# LLM providers (fill only the ones you use)
GEMINI_API_KEY=
GROQ_API_KEY=
COHERE_API_KEY=
ANTHROPIC_API_KEY=
NVIDIA_API_KEY=

# Admin API (used by knowley-web Sorular panel)
KNOWLEY_UI_PORT=8765
# Question edit/delete endpoints stay disabled unless true
KNOWLEY_QUESTION_EDITS_ENABLED=false
# Generation writes to Firestore stay disabled unless true
KNOWLEY_GENERATION_WRITES_ENABLED=false
